<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">#121212</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Opt into edge-to-edge enforced by Android 15 (SDK 35) -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>
</resources>
